# Copie para .env (que é ignorado pelo git) e preencha. Nunca versione o .env.
# Trocar de provedor/modelo = mudar só estas linhas (D-016).

LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
# Fallback de recusa do lado do servidor (Anthropic): off | default
# E-003 exige "off": avalia uma configuração fixa; recusa é resultado, não é respondida por outro modelo.
LLM_FALLBACKS=off

ANTHROPIC_API_KEY=
